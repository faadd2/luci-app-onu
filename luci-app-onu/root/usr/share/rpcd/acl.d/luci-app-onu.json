{
	"luci-app-onu": {
		"description": "Grant access to ONU PON status, configuration and board data",
		"read": {
			"cgi-io": [ "exec" ],
			"uci": [ "pon", "airoha-pon-debug" ],
			"ubus": {
				"file": [ "read" ]
			},
			"file": {
				"/usr/sbin/ponctl --device * status": [ "exec" ],
				"/usr/sbin/ponctl --device * status --json": [ "exec" ],
				"/usr/bin/pondctl status --line *": [ "exec" ],
				"/usr/bin/timeout * pondctl events --line *": [ "exec" ],
				"/sbin/logread -e *": [ "exec" ],
				"/usr/libexec/pon-board-identity list": [ "exec" ],
				"/usr/libexec/pon-board-identity read *": [ "exec" ],
				"/usr/libexec/airoha-pon-data list": [ "exec" ],
				"/usr/libexec/onu-pond-patch status": [ "exec" ],
				"/sys/kernel/debug/airoha-xpon-pon0/pcs": [ "read" ],
				"/sys/kernel/debug/airoha-xpon-pon0/frontend": [ "read" ],
				"/sys/kernel/debug/airoha-xpon-pon0/mac": [ "read" ],
				"/sys/kernel/debug/airoha-xpon-pon0/line": [ "read" ],
				"/etc/pon-fix-version": [ "read" ],
				"/tmp/pon-debug.tar.gz": [ "read" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"uci": [ "pon", "airoha-pon-debug" ],
			"ubus": {
				"file": [ "exec", "write" ]
			},
			"file": {
				"/tmp/pon-board-data.bin": [ "write" ],
				"/usr/libexec/airoha-pon-data write *": [ "exec" ],
				"/usr/libexec/pon-board-identity write *": [ "exec" ],
				"/usr/libexec/airoha-pon-debug collect": [ "exec" ],
				"/usr/libexec/airoha-pon-debug restart": [ "exec" ],
				"/usr/libexec/onu-pond-patch set *": [ "exec" ]
			}
		}
	}
}
