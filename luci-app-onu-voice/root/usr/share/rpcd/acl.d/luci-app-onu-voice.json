{
	"luci-app-onu-voice": {
		"description": "Grant access to ONU 语音 module",
		"read": {
			"uci": [
				"network",
				"onu"
			],
			"ubus": {
				"file": [
					"exec"
				]
			},
			"file": {
				"/sbin/ifstatus voip": [ "exec" ],
				"/bin/ping -c *": [ "exec" ],
				"/usr/libexec/onu-voice-status": [ "exec" ],
				"/sbin/logread -e *": [ "exec" ],
				"/bin/dmesg": [ "exec" ]
			}
		},
		"write": {
			"uci": [
				"network",
				"onu"
			],
			"ubus": {
				"file": [
					"exec"
				]
			},
			"file": {
				"/usr/libexec/onu-voice-apply": [ "exec" ],
				"/usr/libexec/onu-voice-phone *": [ "exec" ],
				"/usr/libexec/onu-voice-extstatus *": [ "exec" ],
				"/usr/libexec/onu-voice-extstatus": [ "exec" ],
				"/etc/init.d/baresip *": [ "exec" ]
			}
		}
	}
}
