#!/bin/sh
# onu-voice-phone — baresip ctrl_tcp 桥（LuCI 软话机页后端）
# 用法: onu-voice-phone status|dial <号码>|answer|hangup|hangupall
# 协议: baresip mod-ctrl_tcp netstring JSON；监听地址 = baresip 配置的 sip_listen 同款 LAN IP
# （ctrl_tcp 绑定 LAN IP 后 127.0.0.1 不再可达，必须按 uci 动态解析，勿写死）
CTRL_PORT=4444
CTRL_HOST=$(uci -q get network.lan.ipaddr 2>/dev/null | cut -d/ -f1)
[ -z "$CTRL_HOST" ] && CTRL_HOST=127.0.0.1

ctrl_cmd() {
	# $1 = JSON 请求行；baresip ctrl_tcp 使用 netstring 成帧（<len>:<json>,）
	# 同连接会收到事件推送，需逐条解帧并只取含 "response" 的响应行
	local payload="$1" len
	len=$(printf '%s' "$payload" | wc -c)
	printf '%s:%s,' "$len" "$payload" \
		| { cat; sleep 1; } \
		| timeout 3 nc "$CTRL_HOST" $CTRL_PORT 2>/dev/null \
		| tr -d '\000' \
		| awk '
			{ buf = buf $0 }
			{
				while (match(buf, /^[0-9]+:/)) {
					n = substr(buf, RSTART, RLENGTH - 1) + 0
					rest = substr(buf, RSTART + RLENGTH)
					if (length(rest) < n + 1) break
					msg = substr(rest, 1, n)
					if (msg ~ /"response"/) { print msg; found = 1; exit }
					buf = substr(rest, n + 2)
				}
			}
			END { if (!found) print "{\"response\":false,\"error\":\"no reply from baresip\"}" }
		'
}

case "$1" in
	status)
		ctrl_cmd '{"command":"listcalls","token":"onu"}'
		;;
	dial)
		[ -z "$2" ] && { echo '{"response":false,"error":"missing number"}'; exit 1; }
		uri="$2"
		case "$uri" in
			sip:*|tel:*) ;;
			*)
				gw_mode=$(uci -q get onu.ims.gw_mode)
				[ -z "$gw_mode" ] && gw_mode="direct"
				if [ "$gw_mode" = "gateway" ]; then
					# 网关模式：所有拨号经 Asterisk（内部分机/外部号码统一打 LAN 地址）
					lan_ip=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
					[ -z "$lan_ip" ] && lan_ip="192.168.1.1"
					uri="sip:${uri}@${lan_ip}"
				else
					# 直通模式：bare 号码拼到 IMS 代理（历史行为）
					proxy=$(uci -q get onu.ims.proxy | awk '{print $1}')
					[ -z "$proxy" ] && proxy="10.203.255.17"
					uri="sip:${uri}@${proxy}"
				fi
				;;
		esac
		# JSON 转义（号码仅含数字与 *#+ 时无特殊字符，保守起见去引号）
		uri=$(printf '%s' "$uri" | tr -d '"\\')

		# b2bua 入局 UA（免注册 LAN 账户）存在时，menu 的当前 UA 恒为它，
		# 直接 dial 会以 swphone@... 为 From 被 SBC 403。拨号前临时摘除该 UA
		# （menu 当前 UA 回落到 IMS 账户），拨号成功发出后立即 uanew 复原。
		# 代价：摘除窗口（<1s）内打到 LAN 入局 UA 的来电会漏接（interim 接受）。
		in_aor=""
		in_uri=""
		i=0
		while ap=$(uci -q get baresip.@account[$i].append 2>/dev/null); do
			[ "${ap#*b2bua=inbound}" != "$ap" ] || { i=$((i+1)); continue; }
			u=$(uci -q get baresip.@account[$i].user 2>/dev/null)
			s=$(uci -q get baresip.@account[$i].server 2>/dev/null)
			t=$(uci -q get baresip.@account[$i].transport 2>/dev/null)
			t=${t:-udp}
			[ -n "$u" ] && [ -n "$s" ] && {
				in_uri="sip:${u}@${s}"
				in_aor="<sip:${u}@${s};transport=${t}>;${ap}"
			}
			break
		done

		[ -n "$in_uri" ] && \
			ctrl_cmd "{\"command\":\"uadel\",\"params\":\"${in_uri}\",\"token\":\"onu-del\"}" >/dev/null

		ctrl_cmd "{\"command\":\"dial\",\"params\":\"${uri}\",\"token\":\"onu\"}"

		if [ -n "$in_aor" ]; then
			sleep 1
			ctrl_cmd "{\"command\":\"uanew\",\"params\":\"${in_aor}\",\"token\":\"onu-new\"}" >/dev/null
			# b2bua 只在模块加载/启动时扫描 UA，uanew 新建的入局 UA 不会被
			# 自动挂钩（/b2bua 的 inbound 为空）；重载模块使其重新扫描两个 UA。
			sleep 1
			ctrl_cmd '{"command":"rmmod","params":"b2bua","token":"onu-rm"}' >/dev/null
			sleep 1
			ctrl_cmd '{"command":"insmod","params":"b2bua","token":"onu-in"}' >/dev/null
		fi
		;;
	answer)
		ctrl_cmd '{"command":"accept","token":"onu"}'
		;;
	hangup)
		ctrl_cmd '{"command":"hangup","token":"onu"}'
		;;
	hangupall)
		ctrl_cmd '{"command":"hangupall","token":"onu"}'
		;;
	raw)
		# 透传任意 JSON：onu-voice-phone raw '<json>'
		shift
		ctrl_cmd "$1"
		;;
	*)
		echo "usage: $0 status|dial <number>|answer|hangup|hangupall" >&2
		exit 1
		;;
esac
