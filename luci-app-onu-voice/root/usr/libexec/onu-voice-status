#!/bin/sh
# onu-voice-status — 语音链路状态采集（LuCI file exec 调用，输出 JSON）
. /lib/functions.sh

json_add_str() { printf '"%s":"%s",' "$1" "$2"; }

# 1) SLIC/驱动状态
slic_bound=0
[ -e /sys/bus/platform/devices/1fbd1000.zsi:slic@0/driver ] && slic_bound=1
slic_msg=$(dmesg | grep -E "Le964|chip id|bring-up failed" | tail -1)
mods=$(lsmod | grep -cE "en75xx_(lec|pcm|zsi|slic|voice)")
pcm_irq=$(grep -c "1fbd0000.pcm" /proc/interrupts)
voice_dev=$(ls /dev/ | grep -ci voice)

# 2) baresip 进程
bpid=$(pidof baresip 2>/dev/null)
baresip_running=0
[ -n "$bpid" ] && baresip_running=1

# 3) 注册状态（从 syslog 最近记录判断）
reg_lines=$(logread 2>/dev/null | grep -iE "baresip.*(regist|200 OK|expiry)" | tail -3 | tr '"' "'" | tr '\n' '|' )
reg_ok=0
echo "$reg_lines" | grep -qiE "200 OK|registered|expiry" && reg_ok=1

# 4) voip 接口
voip_up=$(ifstatus voip 2>/dev/null | grep -c '"up": true')
voip_ip=$(ip -4 addr show dev pon0.3010 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)

printf '{'
printf '"slic_bound":"%s",' "$slic_bound"
printf '"slic_msg":"%s",' "$slic_msg"
printf '"voice_mods":"%s",' "$mods"
printf '"pcm_irq":"%s",' "$pcm_irq"
printf '"voice_dev":"%s",' "$voice_dev"
printf '"baresip_running":"%s",' "$baresip_running"
printf '"reg_ok":"%s",' "$reg_ok"
printf '"reg_lines":"%s",' "$reg_lines"
printf '"voip_up":"%s",' "$voip_up"
printf '"voip_ip":"%s"' "$voip_ip"
printf '}\n'
