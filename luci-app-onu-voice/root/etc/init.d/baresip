#!/bin/sh /etc/rc.common
# baresip init 脚本（procd）：北京联通 IMS SIP 客户端
USE_PROCD=1
START=99
STOP=10

start_service() {
	[ -f /root/.baresip/accounts ] || return 0
	procd_open_instance baresip
	procd_set_param command /usr/bin/baresip -f /root/.baresip
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
