#!/bin/sh /etc/rc.common
# baresip 服务（ZN504XG-D 定制版，替换 OpenWrt 原版）
# 原版从 UCI baresip 段读账号并以 baresip 用户跑 /etc/baresip——
# 与本项目 onu.ims UCI + /root/.baresip（root、固定源端口 5060）架构不兼容。
# 本版：root 运行，配置由 /usr/libexec/onu-voice-apply 从 UCI onu.ims 生成。
START=92
USE_PROCD=1
PROG=/usr/bin/baresip

boot() {
    # 等 voip 口就绪（VLAN 3010 由 netifd 拉起后才绑定监听地址）
    start
}

start_service() {
    [ -x "$PROG" ] || return 0
    [ -f /root/.baresip/config ] || /usr/libexec/onu-voice-apply >/dev/null 2>&1 || true
    [ -f /root/.baresip/config ] || return 0

    procd_open_instance
    procd_set_param command $PROG -f /root/.baresip -s
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

reload_service() {
    restart
}
