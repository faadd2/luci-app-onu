{
	"luci-app-onu-mgmt": {
		"description": "Grant access to ONU ACS (TR-069) management",
		"read": {
			"uci": [ "easycwmp", "acs", "network" ],
			"ubus": {
				"file": [ "exec", "read" ]
			},
			"file": {
				"/etc/init.d/easycwmpd enabled": [ "exec" ],
				"/sbin/logread -e *": [ "exec" ],
				"/tmp/acs-capture.log": [ "read" ],
				"/tmp/acs-capture.pid": [ "read" ],
				"/tmp/acs-capture.pcap": [ "read" ]
			}
		},
		"write": {
			"uci": [ "easycwmp", "acs" ],
			"ubus": {
				"file": [ "exec", "write" ]
			},
			"file": {
				"/etc/init.d/easycwmpd restart": [ "exec" ],
				"/usr/libexec/onu-acs-install": [ "exec" ],
				"/bin/sh -c *": [ "exec" ],
				"/tmp/acs-capture.pid": [ "write" ]
			}
		}
	}
}
