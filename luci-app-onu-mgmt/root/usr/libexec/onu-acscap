#!/bin/sh
# onu-acscap — ACS (TR-069) 抓包助手
# 用法: onu-acscap {start|stop|status|log}
# 设计要点:
#   1. tcpdump 经 setsid 脱离调用会话,避免 rpcd/SSH 会话关闭时的 SIGHUP 杀进程
#   2. 状态判定 = pid 文件 + /proc/<pid>/cmdline 双重校验,杜绝 pid 复用误报
#   3. log 子命令输出"包数 + 字节数"实时进度(tcpdump -w 模式运行期间日志恒空,属预期)
PCAP=/tmp/acs-capture.pcap
CLOG=/tmp/acs-capture.log
CPID=/tmp/acs-capture.pid
IFACE=pppoe-tr069
FILTER="port 7547 or port 9090"

is_running() {
    local pid
    [ -f "$CPID" ] || return 1
    pid=$(cat "$CPID" 2>/dev/null)
    [ -n "$pid" ] || return 1
    [ -d "/proc/$pid" ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$PCAP"
}

case "$1" in
    start)
        if is_running; then
            echo "ALREADY $(cat $CPID)"
            exit 0
        fi
        rm -f "$PCAP" "$CLOG"
        # 脱离调用会话(rpcd/SSH 关闭时不被 SIGHUP 杀掉)
        if command -v setsid >/dev/null 2>&1; then
            setsid /usr/bin/tcpdump -i "$IFACE" -s 0 -nn -w "$PCAP" "$FILTER" \
                > "$CLOG" 2>&1 < /dev/null &
        else
            nohup /usr/bin/tcpdump -i "$IFACE" -s 0 -nn -w "$PCAP" "$FILTER" \
                > "$CLOG" 2>&1 < /dev/null &
        fi
        echo $! > "$CPID"
        sleep 1
        if is_running; then
            echo "STARTED $(cat $CPID)"
        else
            echo "FAILED"
            cat "$CLOG" 2>/dev/null
            exit 1
        fi
        ;;
    stop)
        if is_running; then
            kill "$(cat "$CPID")" 2>/dev/null
            sleep 1
        fi
        rm -f "$CPID"
        echo STOPPED
        ;;
    status)
        if is_running; then
            echo "RUNNING $(cat $CPID)"
        else
            echo STOPPED
        fi
        ;;
    log)
        echo "— 实时进度（tcpdump -w 模式运行期间无文本输出，属正常）—"
        if [ -f "$PCAP" ]; then
            echo "PCAP: $(wc -c < "$PCAP") 字节"
        else
            echo "PCAP: 尚无文件"
        fi
        [ -s "$CLOG" ] && { echo "— tcpdump 输出（停止后才有内容）—"; tail -n 8 "$CLOG"; }
        ;;
    *)
        echo "用法: onu-acscap {start|stop|status|log}" >&2
        exit 2
        ;;
esac
